rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidShareSlug(slug) {
      return slug is string && slug.size() >= 16 && slug.size() <= 64 && slug.matches('^[a-zA-Z0-9_-]+$');
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 320
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTopic(data, userId, topicId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'slug', 'sortOrder', 'isSystemInbox', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'slug', 'sortOrder', 'isSystemInbox', 'createdAt'])
        && data.id is string
        && data.id == topicId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 60
        && data.slug is string
        && data.slug.size() >= 1
        && data.slug.size() <= 80
        && data.sortOrder is int
        && data.sortOrder >= 0
        && data.sortOrder <= 10000
        && data.isSystemInbox is bool
        && data.createdAt is timestamp;
    }

    function isValidNoteTags(tags) {
      return tags is list
        && tags.size() <= 3
        && (tags.size() < 1 || (tags[0] is string && tags[0].size() >= 1 && tags[0].size() <= 24))
        && (tags.size() < 2 || (tags[1] is string && tags[1].size() >= 1 && tags[1].size() <= 24))
        && (tags.size() < 3 || (tags[2] is string && tags[2].size() >= 1 && tags[2].size() <= 24));
    }

    function isValidNote(data, userId, noteId) {
      return data.keys().hasAll(['id', 'userId', 'topicId', 'title', 'content', 'status', 'tags', 'summary', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'topicId', 'title', 'content', 'status', 'tags', 'summary', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id == noteId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.topicId is string
        && isValidId(data.topicId)
        && data.title is string
        && data.title.size() <= 200
        && data.content is string
        && data.content.size() <= 100000
        && data.status in ['DRAFT', 'ARCHIVED']
        && isValidNoteTags(data.tags)
        && data.summary is string
        && data.summary.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCourseRef(data, userId, noteId, refId) {
      return data.keys().hasAll(['id', 'noteId', 'userId', 'type', 'title', 'provider', 'summary', 'url', 'createdAt'])
        && data.keys().hasOnly(['id', 'noteId', 'userId', 'type', 'title', 'provider', 'summary', 'url', 'createdAt'])
        && data.id is string
        && data.id == refId
        && isValidId(data.id)
        && data.noteId is string
        && data.noteId == noteId
        && isValidId(data.noteId)
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.type in ['COURSE', 'PAPER']
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 300
        && data.provider in ['MIT_OCW', 'CURATED_OCW', 'OPENALEX']
        && data.summary is string
        && data.summary.size() <= 600
        && data.url is string
        && data.url.size() >= 8
        && data.url.size() <= 1000
        && data.url.matches('^https?://.*')
        && data.createdAt is timestamp;
    }

    function isValidShareBundle(data, slug) {
      return data.keys().hasAll(['id', 'slug', 'userId', 'title', 'noteCount', 'createdAt'])
        && data.keys().hasOnly(['id', 'slug', 'userId', 'title', 'noteCount', 'createdAt'])
        && data.id is string
        && data.id == slug
        && data.slug is string
        && data.slug == slug
        && isValidShareSlug(data.slug)
        && data.userId is string
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.noteCount is int
        && data.noteCount >= 1
        && data.noteCount <= 50
        && data.createdAt is timestamp;
    }

    function isValidShareItem(data, slug, noteId) {
      return data.keys().hasAll(['id', 'bundleSlug', 'userId', 'title', 'content', 'tags', 'summary', 'updatedAtIso', 'sortOrder', 'courseRefs'])
        && data.keys().hasOnly(['id', 'bundleSlug', 'userId', 'title', 'content', 'tags', 'summary', 'updatedAtIso', 'sortOrder', 'courseRefs'])
        && data.id is string
        && data.id == noteId
        && isValidId(data.id)
        && data.bundleSlug is string
        && data.bundleSlug == slug
        && isValidShareSlug(data.bundleSlug)
        && data.userId is string
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && data.title is string
        && data.title.size() <= 200
        && data.content is string
        && data.content.size() <= 100000
        && isValidNoteTags(data.tags)
        && data.summary is string
        && data.summary.size() <= 300
        && data.updatedAtIso is string
        && data.updatedAtIso.size() <= 64
        && data.sortOrder is int
        && data.sortOrder >= 0
        && data.sortOrder <= 50
        && data.courseRefs is list
        && data.courseRefs.size() <= 25
        && (
          data.courseRefs.size() == 0
          || (
            data.courseRefs[0] is map
            && data.courseRefs[0].url is string
            && data.courseRefs[0].url.matches('^https?://.*')
          )
        );
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /topics/{topicId} {
        allow get: if isOwner(userId) && isValidId(topicId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(topicId)
          && isValidTopic(incoming(), userId, topicId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId)
          && isValidId(topicId)
          && isValidTopic(incoming(), userId, topicId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().isSystemInbox == existing().isSystemInbox
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'sortOrder']);
        allow delete: if isOwner(userId)
          && isValidId(topicId)
          && existing().isSystemInbox == false;
      }

      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(noteId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(noteId)
          && isValidNote(incoming(), userId, noteId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId)/topics/$(incoming().topicId));
        allow update: if isOwner(userId)
          && isValidId(noteId)
          && isValidNote(incoming(), userId, noteId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'topicId', 'updatedAt'])
              && (
                incoming().topicId == existing().topicId
                || exists(/databases/$(database)/documents/users/$(userId)/topics/$(incoming().topicId))
              )
            )
            || (
              incoming().status == 'ARCHIVED'
              && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'topicId', 'status', 'tags', 'summary', 'updatedAt'])
              && exists(/databases/$(database)/documents/users/$(userId)/topics/$(incoming().topicId))
            )
          );
        allow delete: if isOwner(userId) && isValidId(noteId);

        match /course_refs/{refId} {
          allow get: if isOwner(userId) && isValidId(noteId) && isValidId(refId);
          allow list: if isOwner(userId) && isValidId(noteId) && existing().userId == request.auth.uid;
          allow create: if isOwner(userId)
            && isValidId(noteId)
            && isValidId(refId)
            && isValidCourseRef(incoming(), userId, noteId, refId)
            && incoming().createdAt == request.time
            && exists(/databases/$(database)/documents/users/$(userId)/notes/$(noteId));
          allow update: if false;
          allow delete: if isOwner(userId) && isValidId(noteId) && isValidId(refId);
        }
      }
    }

    match /share_bundles/{slug} {
      allow get: if isValidShareSlug(slug);
      allow list: if isVerifiedUser() && existing().userId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidShareSlug(slug)
        && isValidShareBundle(incoming(), slug)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidShareSlug(slug)
        && existing().userId == request.auth.uid;

      match /items/{noteId} {
        allow get: if isValidShareSlug(slug) && isValidId(noteId);
        allow list: if isValidShareSlug(slug);
        allow create: if isVerifiedUser()
          && isValidShareSlug(slug)
          && isValidId(noteId)
          && isValidShareItem(incoming(), slug, noteId)
          && get(/databases/$(database)/documents/share_bundles/$(slug)).data.userId == request.auth.uid;
        allow update: if false;
        allow delete: if isVerifiedUser()
          && isValidShareSlug(slug)
          && isValidId(noteId)
          && existing().userId == request.auth.uid;
      }
    }
  }
}
